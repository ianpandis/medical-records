# Copiá este archivo a .env y completá los valores de tu proyecto de Supabase.
# Los encontrás en Supabase → Project Settings → API.

# URL del proyecto
VITE_SUPABASE_URL=https://<tu-project-ref>.supabase.co

# Clave pública (anon / publishable). Es segura en el navegador: el acceso a los datos lo controlan las políticas RLS.
# (También se acepta VITE_SUPABASE_ANON_KEY como nombre alternativo.)
VITE_SUPABASE_PUBLISHABLE_KEY=<tu anon / publishable key>

# IMPORTANTE: nunca pongas acá la service_role key. Todo lo que empieza con VITE_ termina
# incluido en el bundle del frontend y cualquiera puede leerlo.
